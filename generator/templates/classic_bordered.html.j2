{#
  Template 1 of 8: "classic bordered".

  Single column, bordered table, serif body, centred letterhead. The plainest
  layout in the set; the other seven vary column count, rules, type and header
  placement so that template identity is a real source of visual diversity
  rather than a cosmetic one.

  Every value rendered here comes from the same Report object that is written
  to the ground-truth JSON, so the pairing cannot drift.
#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 34px 44px;
    width: 794px;                     /* A4 at 96 CSS px/in */
    font-family: "Times New Roman", Times, serif;
    font-size: 13px;
    color: #000;
    background: #fff;
  }
  .letterhead { text-align: center; border-bottom: 2px solid #000; padding-bottom: 10px; }
  .lab-name { font-size: 23px; font-weight: bold; letter-spacing: 0.5px; }
  .lab-sub { font-size: 11px; margin-top: 3px; }

  .patient { width: 100%; border-collapse: collapse; margin: 16px 0 6px; font-size: 12.5px; }
  .patient td { padding: 3px 0; vertical-align: top; }
  .patient .lbl { width: 96px; font-weight: bold; }
  .patient .gap { width: 42px; }

  .title {
    text-align: center; font-weight: bold; font-size: 14px;
    letter-spacing: 1.2px; margin: 14px 0 8px;
    border-top: 1px solid #000; border-bottom: 1px solid #000; padding: 5px 0;
  }

  table.results { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  table.results th, table.results td { border: 1px solid #000; padding: 5px 8px; }
  table.results th { font-weight: bold; text-align: left; background: #ececec; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  td.flag { text-align: center; font-weight: bold; width: 34px; }

  .footer { margin-top: 22px; font-size: 11px; display: flex; justify-content: space-between; }
  .sig { text-align: right; }
  .sig .line { margin-top: 26px; border-top: 1px solid #000; padding-top: 3px; width: 165px; }
  .endmark { text-align: center; font-size: 11px; margin-top: 14px; letter-spacing: 2px; }
</style>
</head>
<body>

  <div class="letterhead">
    <div class="lab-name">{{ r.report.lab_name }}</div>
    <div class="lab-sub">Diagnostics &amp; Pathology Laboratory &middot; NABL Accredited</div>
    <div class="lab-sub">Ph: 080-{{ '%04d' % (1000 + r.patient.age * 71 % 9000) }} &middot; report@lab.example</div>
  </div>

  <table class="patient">
    <tr>
      <td class="lbl">Patient Name</td><td>: {{ r.patient.name }}</td>
      <td class="gap"></td>
      <td class="lbl">Patient ID</td><td>: {{ r.patient.patient_id }}</td>
    </tr>
    <tr>
      <td class="lbl">Age / Sex</td><td>: {{ r.patient.age }} Yrs / {{ r.patient.sex }}</td>
      <td class="gap"></td>
      <td class="lbl">Collected On</td><td>: {{ r.report.collection_date }}</td>
    </tr>
    <tr>
      <td class="lbl">Referred By</td><td>: Dr. Self</td>
      <td class="gap"></td>
      <td class="lbl">Reported On</td><td>: {{ r.report.report_date }}</td>
    </tr>
  </table>

  <div class="title">COMPLETE BLOOD COUNT (CBC)</div>

  <table class="results">
    <thead>
      <tr>
        <th style="width:38%">Test Description</th>
        <th style="width:16%">Result</th>
        <th class="flag">&nbsp;</th>
        <th style="width:16%">Unit</th>
        <th>Reference Range</th>
      </tr>
    </thead>
    <tbody>
      {% for t in r.tests %}
      <tr>
        <td>{{ t.test_name }}</td>
        <td class="num">{{ t.printed_value }}</td>
        <td class="flag">{% if t.flag in ('H', 'L') %}{{ t.flag }}{% endif %}</td>
        <td>{{ t.unit }}</td>
        <td>{{ t.ref_text }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="endmark">--- End of Report ---</div>

  <div class="footer">
    <div>
      Sample: Whole Blood (EDTA)<br>
      Method: Automated Cell Counter
    </div>
    <div class="sig">
      <div class="line">Dr. A. Verma, MD (Path)<br>Consultant Pathologist</div>
    </div>
  </div>

</body>
</html>
